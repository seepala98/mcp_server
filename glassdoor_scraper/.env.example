# Glassdoor Scraper Configuration

# Browser Settings
SCRAPER_HEADLESS=true
SCRAPER_BROWSER=chromium

# Rate Limiting (seconds)
MIN_DELAY=3.0
MAX_DELAY=8.0

# Job Search Settings
MAX_JOBS=100
MAX_PAGES=10

# Proxy Settings
USE_PROXIES=false
# PROXY_LIST=http://proxy1:8080,http://proxy2:8080

# Output Settings
OUTPUT_DIR=output

# Optional: Custom User Agents (comma-separated)
# CUSTOM_USER_AGENTS=Mozilla/5.0...,Mozilla/5.0...